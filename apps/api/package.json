{
  "name": "@nhi-cv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "types:generate": "wrangler types --config wrangler.jsonc",
    "types:check": "wrangler types --config wrangler.jsonc --check",
    "typecheck": "pnpm run types:generate && tsc -p tsconfig.json",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run"
  },
  "dependencies": {
    "@nhi-cv/contracts": "workspace:*",
    "@nhi-cv/domain": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
