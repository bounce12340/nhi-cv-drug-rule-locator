{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nhi-cv-drug-rule-locator-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // 自訂網域(RDL-018 上線範圍)。custom_domain 由 wrangler 於部署時建立 DNS 與憑證。
  "routes": [{ "pattern": "api.nhi.uic-ai.com", "custom_domain": true }],
  // 必須明寫:設定 routes 後 workers_dev 預設轉為 false,會使既有 *.workers.dev
  // 位址回 404。2026-08-06 曾因此短暫中斷,故顯式保留兩個位址並存。
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATASET_MODE": "DEMO_DATA_ONLY"
  }
}
