# Cloudflare Pages reads this from the build output root. Vite copies public/ there
# verbatim, so this file ships as dist/_headers.
#
# Vite fingerprints every built asset (index-Ch-vGB3t.js), so a given path's bytes
# never change: a new build means a new filename. Those are safe to cache for a year
# and never revalidate. Pages' default is max-age=14400, must-revalidate, which costs
# a returning clinician a revalidation round trip every four hours to be told the
# file they already hold is still current.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html is the opposite case: it is the only file whose path is stable, and it
# is what points at the fingerprinted assets. It must be revalidated every time or a
# deploy would never reach anyone. This restates Pages' default rather than changing
# it, so the intent is on the record next to the rule above.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
