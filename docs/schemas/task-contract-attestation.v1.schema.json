{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bounce12340/nhi-cv-drug-rule-locator/docs/schemas/task-contract-attestation.v1.schema.json",
  "title": "Task-contract attestation (task-contract/v1)",
  "description": "Machine-readable attestation for one dispatched task contract. One file per task, named <task_id>.json, under .github/attestations/. Grandfather clause and adoption dates are documented in docs/attestation-schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_schema",
    "task_id",
    "task_contract",
    "task_contract_sha256",
    "repo",
    "branch",
    "records"
  ],
  "properties": {
    "attestation_schema": { "const": "task-contract/v1" },
    "task_id": {
      "type": "string",
      "pattern": "^TC-[0-9]{8}-[0-9]{2}$"
    },
    "task_contract": {
      "type": "string",
      "pattern": "^docs/task-contracts/TC-[0-9]{8}-[0-9]{2}\\.md$"
    },
    "task_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the dispatched task-contract file bytes (v3.2 §21.5.4). Required from TC-20260802-04 onward; earlier files are grandfathered."
    },
    "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "branch": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/roleRecord" },
      "description": "At least one builder record and one dispatcher-acceptance record."
    }
  },
  "$defs": {
    "roleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "tier",
        "provider",
        "model_display_name",
        "model_id",
        "run_id",
        "head_sha",
        "result"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["builder", "dispatcher-acceptance (task-contract level)"]
        },
        "tier": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model_display_name": { "type": "string", "minLength": 1 },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "description": "Exact model id, or for the acceptance side a pointer to the session execution record per ADR-001 (exact id preserved outside the repo)."
        },
        "reasoning_effort": { "type": "string" },
        "run_id": { "type": "string", "minLength": 1 },
        "head_sha": { "type": "string", "minLength": 7 },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "tokens_used": { "type": "integer", "minimum": 0 },
        "tool_permissions": { "type": "string" },
        "result": { "type": "string", "minLength": 1 }
      }
    }
  }
}
